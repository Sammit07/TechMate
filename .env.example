# Copy this file to .env and fill in the values. Never commit .env.
# On Vercel, set the same variables in Project Settings -> Environment Variables.

# --- Nebius Token Factory (OpenAI-compatible API) ---
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
TOKEN_FACTORY_API_KEY=
# Model IDs ("Routing key" in the Token Factory console).
# Fast model: classification, routing, quick answers, KB authoring.
MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# Reasoning model: troubleshooting conversations, diagnosis.
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
# Embedding model for vector search, and the vector size to request (Qwen3 supports smaller sizes).
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIMENSIONS=1024

# --- FalkorDB Cloud (Deployments > Instances > your instance) ---
# Connectivity tab: endpoint host and port. Instance Details tab: user and password.
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
# true on paid tiers with TLS enabled; the free tier has no TLS.
FALKORDB_SSL=false
GRAPH_NAME=it_support

# --- Backend ---
# Business time zone for ticket timestamps, "today" and forecasts (servers may run in UTC).
APP_TIMEZONE=Asia/Kolkata
# Comma-separated browser origins allowed to call the API (local Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Per-IP limits for the public API (no sign-in).
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_WRITE_PER_MINUTE=20
# Uploads (ticket CSV, knowledge documents, maintenance/power notices).
# Set ADMIN_TOKEN to require an upload key; leave empty to allow anyone (local use only).
ADMIN_TOKEN=
MAX_UPLOAD_MB=4

# --- Sign-in ---
# One shared password for the whole app. REQUIRED in production; empty = no sign-in (local only).
APP_PASSWORD=
# Optional: secret that signs session cookies (default: derived from APP_PASSWORD).
# Set a long random value to keep sessions valid across password changes, or change it to sign everyone out.
AUTH_SECRET=
SESSION_DAYS=7

# --- Workspaces ---
# Each workspace is its own graph; the list of workspaces is kept in this graph.
META_GRAPH=techmate_meta
DEFAULT_WORKSPACE_NAME=Acme Global IT (demo)
